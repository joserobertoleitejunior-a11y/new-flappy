# Copie este arquivo pra .env (nunca commitado — ver .gitignore) e preencha
# com os IDs reais da sua conta AdMob antes de empacotar o app com Capacitor
# (spec §5/§6). Sem essas variáveis, o jogo roda com anúncios simulados
# (ver src/ads/AdManager.js) — útil pra testar o fluxo sem conta configurada.
#
# Padrão do Vite: só variáveis prefixadas com VITE_ chegam ao código do
# navegador (import.meta.env). Nenhuma chave real deve ir pro código-fonte
# (PADROES-AGENCIA.md §4).

VITE_ADMOB_APP_ID=
VITE_ADMOB_INTERSTITIAL_UNIT_ID=
VITE_ADMOB_REWARDED_UNIT_ID=
